<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.race.chipcheck.controller.RaceManagementController"
            prefHeight="700.0" prefWidth="1350.0">

    <!-- 顶部：操作按钮 -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10;">
            <Button fx:id="addButton" text="新增赛事" onAction="#handleAdd"
                    style="-fx-font-size: 14px; -fx-padding: 8 20;"/>
            <Button fx:id="editButton" text="编辑赛事" onAction="#handleEdit"
                    style="-fx-font-size: 14px; -fx-padding: 8 20;"/>
            <Button fx:id="deleteButton" text="删除赛事" onAction="#handleDelete"
                    style="-fx-font-size: 14px; -fx-padding: 8 20;"/>
            <Separator orientation="VERTICAL" prefHeight="30"/>
            <Button fx:id="refreshButton" text="刷新" onAction="#handleRefresh"
                    style="-fx-font-size: 14px; -fx-padding: 8 20;"/>
        </HBox>
    </top>

    <!-- 中间：TableView -->
    <center>
        <TableView fx:id="raceTable" style="-fx-font-size: 13px;">
            <columns>
                <TableColumn fx:id="idColumn" text="赛事ID" prefWidth="100"/>
                <TableColumn fx:id="nameColumn" text="赛事名称" prefWidth="400"/>
                <TableColumn fx:id="createdTimeColumn" text="创建时间" prefWidth="200"/>
            </columns>
            <placeholder>
                <Label text="暂无赛事，点击"新增赛事"按钮创建"
                       style="-fx-font-size: 14px; -fx-text-fill: gray;"/>
            </placeholder>
        </TableView>
    </center>

    <!-- 底部：提示信息 -->
    <bottom>
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: #f5f5f5;">
            <Label text="提示：双击行可快速编辑赛事名称"
                   style="-fx-font-size: 13px; -fx-text-fill: #666;"/>
        </HBox>
    </bottom>

</BorderPane>
