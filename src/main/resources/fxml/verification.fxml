<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.race.chipcheck.controller.VerificationController"
            prefHeight="700.0" prefWidth="1350.0">

    <!-- 顶部：控制栏 -->
    <top>
        <VBox spacing="10" style="-fx-padding: 10;">
            <!-- 第一行：连接按钮和状态 + 设置 -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Button fx:id="connectButton" text="连接读卡器" onAction="#handleConnect"
                        style="-fx-font-size: 14px; -fx-padding: 8 20;"/>

                <Label text="读卡器状态：" style="-fx-font-size: 14px;"/>
                <Circle fx:id="readerStatusIndicator" radius="8"/>
                <Label fx:id="readerStatusLabel" text="未连接" style="-fx-font-size: 14px;"/>

                <Separator orientation="VERTICAL" prefHeight="30"/>

                <Button fx:id="clearButton" text="清空记录" onAction="#handleClear"
                        style="-fx-font-size: 13px;">
                    <tooltip>
                        <Tooltip text="左键：清空显示记录&#10;右键：清空核验统计"/>
                    </tooltip>
                </Button>

                <Button fx:id="clearStatisticsButton" text="清空核验人数" onAction="#handleClearStatistics"
                        style="-fx-font-size: 13px;">
                    <tooltip>
                        <Tooltip text="清空当前赛事的核验人数统计和所有核验记录"/>
                    </tooltip>
                </Button>

                <Separator orientation="VERTICAL" prefHeight="30"/>

                <!-- 语音播报设置 -->
                <VBox spacing="5">
                    <Label text="语音播报设置" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <CheckBox fx:id="voiceEnabledCheckbox" text="启用语音" style="-fx-font-size: 12px;"/>
                        <Label text="播报:" style="-fx-font-size: 11px;"/>
                        <RadioButton fx:id="voiceContentBibRadio" text="号码布" selected="true" style="-fx-font-size: 11px;"/>
                        <RadioButton fx:id="voiceContentNameRadio" text="姓名" style="-fx-font-size: 11px;"/>
                    </HBox>
                </VBox>

                <Separator orientation="VERTICAL" prefHeight="30"/>

                <!-- 报警声音设置 -->
                <CheckBox fx:id="alertSoundCheckbox" text="启用报警声音" selected="true" style="-fx-font-size: 12px;"/>
            </HBox>

            <!-- 第二行：核验测试 -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: #fffbf0; -fx-border-color: #ffd700; -fx-border-radius: 5;">
                <Label text="核验测试：" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <TextField fx:id="testChipIdField" promptText="手动输入芯片号进行测试" prefWidth="300"
                           style="-fx-font-size: 14px;"/>
                <Button fx:id="testButton" text="测试核验" onAction="#handleTest"
                        style="-fx-font-size: 14px; -fx-padding: 8 20; -fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                <Label text="（用于测试系统是否正常工作）" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
            </HBox>
        </VBox>
    </top>

    <!-- 中间：TableView -->
    <center>
        <TableView fx:id="recordTable" style="-fx-font-size: 13px;">
            <columns>
                <TableColumn fx:id="timeColumn" text="核验时间" prefWidth="150"/>
                <TableColumn fx:id="chipIdColumn" text="芯片号" prefWidth="180"/>
                <TableColumn fx:id="bibNumberColumn" text="参赛号" prefWidth="100"/>
                <TableColumn fx:id="nameColumn" text="姓名" prefWidth="120"/>
                <TableColumn fx:id="statusColumn" text="状态" prefWidth="80"/>
                <TableColumn fx:id="remarkColumn" text="备注" prefWidth="200"/>
            </columns>
            <placeholder>
                <Label text="暂无核验记录" style="-fx-font-size: 14px; -fx-text-fill: gray;"/>
            </placeholder>
        </TableView>
    </center>

    <!-- 底部：统计信息 -->
    <bottom>
        <HBox spacing="30" alignment="CENTER_LEFT" style="-fx-padding: 15; -fx-background-color: #f5f5f5;">
            <Label fx:id="recordCountLabel" text="核验记录数: 0"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Label fx:id="totalAthleteCountLabel" text="总人数: 0"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #666666;"/>
            <Label fx:id="athleteCountLabel" text="已核验人数: 0"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;"/>
            <Label fx:id="unverifiedCountLabel" text="未核验人数: 0"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #FF9800;"/>
        </HBox>
    </bottom>

</BorderPane>
